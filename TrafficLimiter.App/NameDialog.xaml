<Window x:Class="TrafficLimiter.App.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrafficLimiter.App"
        Title="{local:T profile_name_title}" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="22">
        <TextBlock Text="{local:T profile_name_prompt}" Style="{StaticResource Muted}" Margin="0,0,0,8" />
        <TextBox x:Name="NameBox" Style="{StaticResource Input}" MaxLength="40" Padding="10,8" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{local:T btn_cancel}" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,10,0" />
            <Button Content="{local:T btn_ok}" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok" />
        </StackPanel>
    </StackPanel>
</Window>
