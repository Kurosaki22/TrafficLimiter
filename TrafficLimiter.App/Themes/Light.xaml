<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Oberfläche: neutrales Papier, Farbe nur für Daten -->
    <SolidColorBrush x:Key="WindowBg" Color="#F3F3F1" />
    <SolidColorBrush x:Key="CardBg" Color="#FBFBFA" />
    <SolidColorBrush x:Key="CardBorder" Color="#DDDDD9" />
    <SolidColorBrush x:Key="InputBg" Color="#ECECE9" />
    <SolidColorBrush x:Key="InputBorder" Color="#C9C9C4" />
    <SolidColorBrush x:Key="TextPrimary" Color="#16171A" />
    <SolidColorBrush x:Key="TextMuted" Color="#5E6169" />
    <SolidColorBrush x:Key="RowHover" Color="#EAEAE7" />
    <SolidColorBrush x:Key="RowSelected" Color="#DEDED9" />
    <SolidColorBrush x:Key="DangerTint" Color="#FBE4E4" />
    <SolidColorBrush x:Key="ChartGrid" Color="#E2E2DE" />

    <!-- Auswahl, Fokus und Hauptaktion: Tinte, nie Datenfarbe -->
    <SolidColorBrush x:Key="Accent" Color="#16171A" />
    <SolidColorBrush x:Key="OnAccent" Color="#F3F3F1" />
    <SolidColorBrush x:Key="FocusRing" Color="#16171A" />

    <!-- Datenfarben (aus dem App-Symbol), für hellen Grund nachgedunkelt -->
    <SolidColorBrush x:Key="DownBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="UpBrush" Color="#B45309" />
    <SolidColorBrush x:Key="LimitBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="Danger" Color="#C42B20" />
    <SolidColorBrush x:Key="OnDanger" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Ok" Color="#1E7F4A" />
</ResourceDictionary>
