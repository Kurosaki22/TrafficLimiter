<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Oberfläche: neutrales Graphit, Farbe nur für Daten -->
    <SolidColorBrush x:Key="WindowBg" Color="#101113" />
    <SolidColorBrush x:Key="CardBg" Color="#16181B" />
    <SolidColorBrush x:Key="CardBorder" Color="#2A2D32" />
    <SolidColorBrush x:Key="InputBg" Color="#1E2024" />
    <SolidColorBrush x:Key="InputBorder" Color="#3A3E45" />
    <SolidColorBrush x:Key="TextPrimary" Color="#ECEDEF" />
    <SolidColorBrush x:Key="TextMuted" Color="#9A9FA8" />
    <SolidColorBrush x:Key="RowHover" Color="#1A1C20" />
    <SolidColorBrush x:Key="RowSelected" Color="#24272C" />
    <SolidColorBrush x:Key="DangerTint" Color="#2A1517" />
    <SolidColorBrush x:Key="ChartGrid" Color="#23262B" />

    <!-- Auswahl, Fokus und Hauptaktion: Tinte, nie Datenfarbe -->
    <SolidColorBrush x:Key="Accent" Color="#ECEDEF" />
    <SolidColorBrush x:Key="OnAccent" Color="#101113" />
    <SolidColorBrush x:Key="FocusRing" Color="#ECEDEF" />

    <!-- Datenfarben (aus dem App-Symbol): Down blau, Up bernstein, Limit violett -->
    <SolidColorBrush x:Key="DownBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="UpBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="LimitBrush" Color="#A78BFA" />
    <SolidColorBrush x:Key="Danger" Color="#FF5A4F" />
    <SolidColorBrush x:Key="OnDanger" Color="#1A0A09" />
    <SolidColorBrush x:Key="Ok" Color="#5BD08A" />
</ResourceDictionary>
