<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms> <!-- only for NotifyIcon (tray) -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>      <!-- ThemeMode (Fluent) is flagged experimental -->
    <AssemblyName>TrafficLimiter</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>TrafficLimiter</Product>
    <AssemblyTitle>TrafficLimiter</AssemblyTitle>
    <Description>Per-application bandwidth limiter and firewall for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\TrafficLimiter.Core\TrafficLimiter.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <Resource Include="app.ico" /> <!-- tray icon is loaded from this resource -->
  </ItemGroup>

</Project>
